return {
  summary = "3D character selector with Aang, Ash Ketchum, BelleStarmon, Cloud, Naruto, OceanGate Titan, Red, Roronoa Zoro, Shrek, Ugandan Knuckles, Sabrina, Wow, Yami, and Yugi Muto for overworld and Dramatic Shape battles.",
  author = "Custom local build",
  tags = { "graphics", "3d", "player-model", "character-selector", "vr", "openxr", "mobile", "touch" },
  differences = {
    changed = {
      "The on-foot player is rendered as the selected textured 3D skinned character.",
      "Dramatic Shape battle trainer cards are replaced by the selected 3D character.",
    },
    added = {
      "Top-level Skin Selector shortcut in the normal pause/start menu, placed immediately after MOD MENUS when present.",
      "Self-contained high-resolution clean Skin Selector UI with a true-color Blender-style orbit/pan/zoom 3D model preview and consistent right-side settings panel; no separate UI mod is required.",
      "Mobile Touch selector mode for Android/iOS and touchscreen hosts with larger tap targets, one-finger orbit/pan, two-finger pinch-zoom + pan, and on-screen Orbit/Pan/Zoom/Reset camera buttons.",
      "Aang, Ash Ketchum, BelleStarmon, Cloud, Naruto, OceanGate Titan, Red, Roronoa Zoro, Shrek, Ugandan Knuckles, Sabrina, Wow, Yami, and Yugi Muto selectable 3D characters.",
      "Per-character 50%-150% visual scale with live Skin Selector preview and per-save persistence.",
      "Per-character HEAD SIZE control from 100%-400% for gigantic-head mode, with soft neck blending and per-save persistence on humanoid rigs.",
      "Per-save character renaming directly in the Skin Selector; display names change without changing stable internal character IDs.",
      "Portable single-file .red3dskin export/import from the Skin Selector for sharing or moving characters between installs.",
      "ZIP accessory importer/editor for static OBJ/FBX/DAE models with material-aware textures, selectable FBX UV mapping, saved texture repair toggles, rigid animated-bone attachment, XYZ placement, scale/rotation, and per-character persistence.",
      "First-class Character Import workflow for loose OBJ/FBX/DAE files or ZIPs, including BelleStarmon/Wow donor-rig cloning with bind-surface weight transfer, axis/fit repair controls, animated preview, and the manual humanoid rigger as an advanced fallback.",
      "BelleStarmon Ctrl walk mode uses half-speed keyboard/digital movement while analog-stick pressure keeps its smooth walk/run behavior.",
      "BelleStarmon and Wow use optional breast-only responsive jiggle physics with independently simulated left/right spring bodies, 240 Hz internal oversampling, filtered targets, and frame-rate-independent presentation smoothing; thigh/buttocks physics remain disabled.",
      "BelleStarmon and Wow each expose one saved PHYSICS checkbox; the BREAST PHYSICS strength slider appears only while physics is enabled, and fresh saves start with physics off.",
      "Wow uses the native Mixamo skin plus the supplied Idle, Catwalk Walk Forward HighKnees, and Goofy Running FBX animations instead of generic auto-rig animation axes, with rigid quaternion sampling and seamless run looping.",
      "Skin Selector footer draws controller button icons and supports D-pad/L3/X/Y/LB/RB/A/B controls.",
      "Skin Selector uses a mod-drawn high-contrast mouse cursor so pointer visibility does not depend on the host OS cursor.",
      "BelleStarmon uses the supplied Goofy Running FBX as a selector-only looping preview animation; gameplay animations are unchanged.",
      "Pre-battle pointing gesture and optional X/Square manual jumping.",
      "Persistent 360-degree body facing in Dramatic Shape free-roam: stop moving and the model keeps its last travel direction while the camera orbits independently.",
      "Collision-safe eight-way on-foot movement in Gen 1 + Gen 2, with four diagonal directions, normalized diagonal speed, and diagonal 3D travel-facing.",
      "Gen 1 Red/Blue/Yellow voxel walk/run animation timing is driven by the visible model pass and diagonal movement preserves the engine's native Player animation clock.",
      "VR support for custom 3D characters in Dramatic/Dramaless Shape: full stereo models in diorama and battle views, plus an animated headless first-person body that follows HMD yaw and room-scale lean without putting face/hair geometry inside the headset.",
      "Android double-tap on empty overworld screen space jumps directly to the voxel renderer's 3RD PERSON camera without triggering from touch-control or multi-touch gesture regions.",
      "Android two-finger pinch/spread on empty overworld space zooms the voxel world; orbit views use survey zoom and 3RD PERSON uses the voxel renderer's boom zoom when exposed.",
    },
    known = {
      "Fishing, surfing, and bicycle states still fall back to the stock 2D player renderer.",
      "Yugi uses the shared procedural movement system; the supplied SMD idle clips are retained as source assets but are not required at runtime.",
      "Donor-rig cloning works best for edited versions of the same BelleStarmon/Wow body; large proportion changes or geometry far from the donor surface may still need the manual humanoid rigger.",
    },
  },
  credits = {
    { who = "Model assets supplied by the mod user", for_ = "Red, Yugi Muto, Roronoa Zoro, Cloud, and Aang character meshes/textures" },
    { who = "OpenAI", for_ = "Gen1Recomp 3D runtime adapter, selector, conversion tools, and animation integration" },
  },
  compat = { engine = ">=0.1.36 <2.0.0", modApi = 2 },
}

